# Deny new top-level paths unless explicitly included.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/MANIFEST.md
!/SECURITY.md
!/global/
!/skills/
!/optimize/
!/review-sync/
# Exclusions never replace pre-copy sanitization.
**/.audit-local/
**/.git/
**/.env
**/.env.*
**/auth.json
**/credentials*
**/*credential*.json
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite*
**/*.db
**/*.jsonl
**/sessions/
**/archived_sessions/
**/.agent/
**/.superpowers/
**/node_modules/
**/.venv/
**/__pycache__/
**/*.pyc
**/build/
**/dist/
**/cache/
**/logs/
